<?xml version="1.0"?>
<sdf version="1.9">
  <world name="paper_alley">
    <physics name="step" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
