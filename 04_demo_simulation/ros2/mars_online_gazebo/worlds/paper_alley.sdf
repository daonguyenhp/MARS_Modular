    <scene><ambient>0.8 0.8 0.8 1</ambient><background>0.95 0.96 0.98 1</background></scene>
    <light type="directional" name="sun"><pose>5 5 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>100</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
