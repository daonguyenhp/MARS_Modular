        <visual name="light_floor"><geometry><box><size>10 10 0.1</size></box></geometry>
          <material><ambient>0.88 0.88 0.82 1</ambient><diffuse>0.88 0.88 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
