Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 10
      Reference Frame: map
      Value: true
    - Alpha: 0.5
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Scenario map (ground truth)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /paper/map
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Sight, open points, bundles
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /paper/markers
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Simulated LiDAR returns
      Style: Points
      Size (Pixels): 3
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 220; 40; 40
      Enabled: true
      Line Style: Lines
      Name: Actual path into alley
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /paper/travelled_entry
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 100; 100; 100
      Enabled: true
      Line Style: Lines
      Name: Retrace baseline (length comparison)
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /paper/retrace_baseline
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 20; 220; 60
      Enabled: true
      Line Style: Lines
      Name: DAP exit path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /paper/exit_path
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Robot pose
      Shape: Arrow
      Color: 25; 100; 255
      Alpha: 1
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /paper/robot_pose
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 180
      Target Frame: map
      Value: TopDownOrtho (rviz_default_plugins)
      X: 50
      Y: 50
Window Geometry:
  Height: 900
  Width: 1400
