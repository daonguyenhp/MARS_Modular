<?xml version="1.0"?>
<robot name="jettank" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Materials matching official Hiwonder JetTank metallic green & matte black hardware -->
  <material name="hiwonder_green">
    <color rgba="0.13 0.69 0.35 1.0"/>
  </material>
  <material name="jet_black">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>
  <material name="matte_track">
    <color rgba="0.18 0.18 0.20 1.0"/>
  </material>
  <material name="metal_silver">
    <color rgba="0.75 0.78 0.82 1.0"/>
  </material>
  <material name="lens_glass">
    <color rgba="0.05 0.08 0.15 1.0"/>
  </material>

  <!-- Base footprint on ground -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- JetTank Main Chassis Body (Iconic Anodized Emerald Green Aluminum) -->
  <link name="base_link">
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.025"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.16 0.08"/>
      </geometry>
    </collision>
    <!-- Visual 1: Main emerald green chassis hull -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.16 0.06"/>
      </geometry>
      <material name="hiwonder_green"/>
    </visual>
    <!-- Visual 2: Sloped front nose plate -->
    <visual>
      <origin xyz="0.11 0 0.04" rpy="0 0.40 0"/>
      <geometry>
        <box size="0.08 0.16 0.006"/>
      </geometry>
      <material name="hiwonder_green"/>
    </visual>
    <!-- Visual 3: Front lower black bumper -->
    <visual>
      <origin xyz="0.115 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.15 0.035"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 4: Front nose ventilation grill slot detail -->
    <visual>
      <origin xyz="0.135 0 0.04" rpy="0 0.40 0"/>
      <geometry>
        <box size="0.005 0.12 0.015"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 5: Middle green deck holding RPLiDAR -->
    <visual>
      <origin xyz="0.01 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.15 0.005"/>
      </geometry>
      <material name="hiwonder_green"/>
    </visual>
    <!-- Visual 6: RPLiDAR lower base mount tray -->
    <visual>
      <origin xyz="0 0 0.095" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.042" length="0.015"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 7: Upper green shelf bracket over RPLiDAR -->
    <visual>
      <origin xyz="0.01 0 0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.14 0.005"/>
      </geometry>
      <material name="hiwonder_green"/>
    </visual>
    <!-- Visual 8: Depth camera pan-tilt gimbal pedestal -->
    <visual>
      <origin xyz="0.02 0 0.155" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 9: Depth camera sensor housing bar -->
    <visual>
      <origin xyz="0.03 0 0.185" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.165 0.032"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 10: Depth camera optical lenses (Center RGB) -->
    <visual>
      <origin xyz="0.048 0 0.185" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.005"/>
      </geometry>
      <material name="lens_glass"/>
    </visual>
    <!-- Visual 11: Depth camera optical lenses (Left IR) -->
    <visual>
      <origin xyz="0.048 0.045 0.185" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.005"/>
      </geometry>
      <material name="lens_glass"/>
    </visual>
    <!-- Visual 12: Depth camera optical lenses (Right IR) -->
    <visual>
      <origin xyz="0.048 -0.045 0.185" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.005"/>
      </geometry>
      <material name="lens_glass"/>
    </visual>
    <!-- Visual 13: Rear Jetson Nano & Display angled backplate -->
    <visual>
      <origin xyz="-0.08 0 0.11" rpy="0 -0.52 0"/>
      <geometry>
        <box size="0.10 0.14 0.05"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 14: Left Wi-Fi antenna -->
    <visual>
      <origin xyz="-0.08 0.055 0.18" rpy="0.20 -0.30 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.10"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 15: Right Wi-Fi antenna -->
    <visual>
      <origin xyz="-0.08 -0.055 0.18" rpy="-0.20 -0.30 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.10"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
  </link>

  <!-- Left Caterpillar Track Assembly (Dải bánh xích bên trái) -->
  <link name="left_wheel">
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.045"/>
      </geometry>
    </collision>
    <!-- Visual 1: Outer metallic green sideplate with diagonal cutouts -->
    <visual>
      <origin xyz="0 0.024 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.23 0.004 0.05"/>
      </geometry>
      <material name="hiwonder_green"/>
    </visual>
    <!-- Visual 2: Rear drive sprocket wheel (Green with holes) -->
    <visual>
      <origin xyz="-0.095 0 0.015" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.044"/>
      </geometry>
      <material name="hiwonder_green"/>
    </visual>
    <!-- Visual 3: Rear sprocket silver hub -->
    <visual>
      <origin xyz="-0.095 0 0.015" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 4: Front raised idler wheel (Ramp climbing angle) -->
    <visual>
      <origin xyz="0.095 0 0.022" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 5: Front idler silver hub -->
    <visual>
      <origin xyz="0.095 0 0.022" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 6: Bottom road wheel 1 -->
    <visual>
      <origin xyz="-0.045 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <visual>
      <origin xyz="-0.045 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 7: Bottom road wheel 2 (Center) -->
    <visual>
      <origin xyz="0 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 8: Bottom road wheel 3 -->
    <visual>
      <origin xyz="0.045 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <visual>
      <origin xyz="0.045 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 9: Top return roller wheel -->
    <visual>
      <origin xyz="0 0 0.034" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 10: Rubber caterpillar track belt - Bottom ground contact run -->
    <visual>
      <origin xyz="0 0 -0.041" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.042 0.012"/>
      </geometry>
      <material name="matte_track"/>
    </visual>
    <!-- Visual 11: Rubber caterpillar track belt - Front upward ramp -->
    <visual>
      <origin xyz="0.09 0 -0.010" rpy="0 -0.55 0"/>
      <geometry>
        <box size="0.08 0.042 0.012"/>
      </geometry>
      <material name="matte_track"/>
    </visual>
    <!-- Visual 12: Rubber caterpillar track belt - Rear upward ramp -->
    <visual>
      <origin xyz="-0.09 0 -0.012" rpy="0 0.48 0"/>
      <geometry>
        <box size="0.08 0.042 0.012"/>
      </geometry>
      <material name="matte_track"/>
    </visual>
    <!-- Visual 13: Rubber caterpillar track belt - Top return run -->
    <visual>
      <origin xyz="0 0 0.050" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.042 0.012"/>
      </geometry>
      <material name="matte_track"/>
    </visual>
    <!-- Visual 14: Top fender / mudguard -->
    <visual>
      <origin xyz="0 0 0.056" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.048 0.005"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.11 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Caterpillar Track Assembly (Dải bánh xích bên phải) -->
  <link name="right_wheel">
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.045"/>
      </geometry>
    </collision>
    <!-- Visual 1: Outer metallic green sideplate with diagonal cutouts -->
    <visual>
      <origin xyz="0 -0.024 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.23 0.004 0.05"/>
      </geometry>
      <material name="hiwonder_green"/>
    </visual>
    <!-- Visual 2: Rear drive sprocket wheel (Green with holes) -->
    <visual>
      <origin xyz="-0.095 0 0.015" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.044"/>
      </geometry>
      <material name="hiwonder_green"/>
    </visual>
    <!-- Visual 3: Rear sprocket silver hub -->
    <visual>
      <origin xyz="-0.095 0 0.015" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 4: Front raised idler wheel (Ramp climbing angle) -->
    <visual>
      <origin xyz="0.095 0 0.022" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 5: Front idler silver hub -->
    <visual>
      <origin xyz="0.095 0 0.022" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 6: Bottom road wheel 1 -->
    <visual>
      <origin xyz="-0.045 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <visual>
      <origin xyz="-0.045 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 7: Bottom road wheel 2 (Center) -->
    <visual>
      <origin xyz="0 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 8: Bottom road wheel 3 -->
    <visual>
      <origin xyz="0.045 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <visual>
      <origin xyz="0.045 0 -0.016" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.046"/>
      </geometry>
      <material name="metal_silver"/>
    </visual>
    <!-- Visual 9: Top return roller wheel -->
    <visual>
      <origin xyz="0 0 0.034" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.044"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- Visual 10: Rubber caterpillar track belt - Bottom ground contact run -->
    <visual>
      <origin xyz="0 0 -0.041" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.042 0.012"/>
      </geometry>
      <material name="matte_track"/>
    </visual>
    <!-- Visual 11: Rubber caterpillar track belt - Front upward ramp -->
    <visual>
      <origin xyz="0.09 0 -0.010" rpy="0 -0.55 0"/>
      <geometry>
        <box size="0.08 0.042 0.012"/>
      </geometry>
      <material name="matte_track"/>
    </visual>
    <!-- Visual 12: Rubber caterpillar track belt - Rear upward ramp -->
    <visual>
      <origin xyz="-0.09 0 -0.012" rpy="0 0.48 0"/>
      <geometry>
        <box size="0.08 0.042 0.012"/>
      </geometry>
      <material name="matte_track"/>
    </visual>
    <!-- Visual 13: Rubber caterpillar track belt - Top return run -->
    <visual>
      <origin xyz="0 0 0.050" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.042 0.012"/>
      </geometry>
      <material name="matte_track"/>
    </visual>
    <!-- Visual 14: Top fender / mudguard -->
    <visual>
      <origin xyz="0 0 0.056" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.048 0.005"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.11 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Lidar mount sensor (elevated above middle deck for unobstructed 360-degree view) -->
  <link name="laser_frame">
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.035"/>
      </geometry>
    </collision>
    <!-- RPLiDAR black rotating cylindrical turret -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.030"/>
      </geometry>
      <material name="jet_black"/>
    </visual>
    <!-- RPLiDAR optical aperture slit band -->
    <visual>
      <origin xyz="0 0 -0.003" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.037" length="0.008"/>
      </geometry>
      <material name="lens_glass"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_frame"/>
  </joint>

  <!-- Gazebo Material Colors -->
  <gazebo reference="base_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo reference="left_wheel">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="laser_frame">
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <!-- Ground-truth 3D Odometry Plugin: ensures odom starts at exact spawn pose in paper alley -->
  <gazebo>
    <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50.0</updateRate>
      <bodyName>base_footprint</bodyName>
      <topicName>odom</topicName>
      <gaussianNoise>0</gaussianNoise>
      <frameName>world</frameName>
      <xyzOffsets>0 0 0</xyzOffsets>
      <rpyOffsets>0 0 0</rpyOffsets>
    </plugin>
  </gazebo>

  <!-- Differential Drive Controller Plugin for JetTank tracks -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>0.22</wheelSeparation>
      <wheelDiameter>0.09</wheelDiameter>
      <wheelTorque>20</wheelTorque>
      <wheelAcceleration>2.0</wheelAcceleration>
      <commandTopic>hiwonder_controller/cmd_vel</commandTopic>
      <odometryTopic>odom_encoder</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishOdomTF>false</publishOdomTF>
      <publishWheelJointState>true</publishWheelJointState>
      <publishTf>0</publishTf>
    </plugin>
  </gazebo>

  <!-- Lidar Ray Sensor Plugin matching Paper limited vision range R = 1.6m -->
  <gazebo reference="laser_frame">
    <sensor type="ray" name="rplidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>8.00</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>scan_raw</topicName>
        <frameName>laser_frame</frameName>
      </plugin>
    </sensor>
  </gazebo>

</robot>
