<?xml version="1.0"?>
<robot name="jettank" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Base footprint on ground -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- JetTank Main Chassis Body -->
  <link name="base_link">
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.025"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.20 0.10"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.20 0.10"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.22 0.25 1.0"/>
      </material>
    </visual>
    <!-- Visual green accent stripe for JetTank -->
    <visual>
      <origin xyz="0.08 0 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.16 0.01"/>
      </geometry>
      <material name="hiwonder_green">
        <color rgba="0.1 0.75 0.3 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Left Caterpillar Track Assembly (Dải bánh xích xe tăng bên trái) -->
  <link name="left_wheel">
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <!-- Collision: main driving track base for skid-steer friction -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.045"/>
      </geometry>
    </collision>
    <!-- Visual 1: Main continuous black rubber caterpillar track belt -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.045 0.07"/>
      </geometry>
      <material name="track_rubber">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <!-- Visual 2: Front driving sprocket wheel -->
    <visual>
      <origin xyz="0.095 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.047"/>
      </geometry>
      <material name="track_wheel">
        <color rgba="0.25 0.28 0.32 1.0"/>
      </material>
    </visual>
    <!-- Visual 3: Rear idler sprocket wheel -->
    <visual>
      <origin xyz="-0.095 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.047"/>
      </geometry>
      <material name="track_wheel">
        <color rgba="0.25 0.28 0.32 1.0"/>
      </material>
    </visual>
    <!-- Visual 4: Middle road wheel 1 -->
    <visual>
      <origin xyz="-0.032 0 -0.005" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.047"/>
      </geometry>
      <material name="track_wheel">
        <color rgba="0.35 0.38 0.42 1.0"/>
      </material>
    </visual>
    <!-- Visual 5: Middle road wheel 2 -->
    <visual>
      <origin xyz="0.032 0 -0.005" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.047"/>
      </geometry>
      <material name="track_wheel">
        <color rgba="0.35 0.38 0.42 1.0"/>
      </material>
    </visual>
    <!-- Visual 6: Track top mudguard / fender -->
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.05 0.008"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.22 0.25 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.11 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Caterpillar Track Assembly (Dải bánh xích xe tăng bên phải) -->
  <link name="right_wheel">
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <!-- Collision: main driving track base for skid-steer friction -->
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.045"/>
      </geometry>
    </collision>
    <!-- Visual 1: Main continuous black rubber caterpillar track belt -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.045 0.07"/>
      </geometry>
      <material name="track_rubber">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <!-- Visual 2: Front driving sprocket wheel -->
    <visual>
      <origin xyz="0.095 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.047"/>
      </geometry>
      <material name="track_wheel">
        <color rgba="0.25 0.28 0.32 1.0"/>
      </material>
    </visual>
    <!-- Visual 3: Rear idler sprocket wheel -->
    <visual>
      <origin xyz="-0.095 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.047"/>
      </geometry>
      <material name="track_wheel">
        <color rgba="0.25 0.28 0.32 1.0"/>
      </material>
    </visual>
    <!-- Visual 4: Middle road wheel 1 -->
    <visual>
      <origin xyz="-0.032 0 -0.005" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.047"/>
      </geometry>
      <material name="track_wheel">
        <color rgba="0.35 0.38 0.42 1.0"/>
      </material>
    </visual>
    <!-- Visual 5: Middle road wheel 2 -->
    <visual>
      <origin xyz="0.032 0 -0.005" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.030" length="0.047"/>
      </geometry>
      <material name="track_wheel">
        <color rgba="0.35 0.38 0.42 1.0"/>
      </material>
    </visual>
    <!-- Visual 6: Track top mudguard / fender -->
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.05 0.008"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.22 0.25 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.11 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Lidar mount mast & sensor (elevated above chassis for clean 360-degree view) -->
  <link name="laser_frame">
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.4 0.9 1.0"/>
      </material>
    </visual>
    <!-- Visual mast / support bracket -->
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.07"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.22 0.25 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_frame"/>
  </joint>

  <!-- Gazebo Material Colors -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="left_wheel">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="laser_frame">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Ground-truth 3D Odometry Plugin: ensures odom starts at exact spawn pose in paper alley -->
  <gazebo>
    <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50.0</updateRate>
      <bodyName>base_footprint</bodyName>
      <topicName>odom</topicName>
      <gaussianNoise>0</gaussianNoise>
      <frameName>world</frameName>
      <xyzOffsets>0 0 0</xyzOffsets>
      <rpyOffsets>0 0 0</rpyOffsets>
    </plugin>
  </gazebo>

  <!-- Differential Drive Controller Plugin for JetTank tracks -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>0.22</wheelSeparation>
      <wheelDiameter>0.09</wheelDiameter>
      <wheelTorque>20</wheelTorque>
      <wheelAcceleration>2.0</wheelAcceleration>
      <commandTopic>hiwonder_controller/cmd_vel</commandTopic>
      <odometryTopic>odom_encoder</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishOdomTF>false</publishOdomTF>
      <publishWheelJointState>true</publishWheelJointState>
      <publishTf>0</publishTf>
    </plugin>
  </gazebo>

  <!-- Lidar Ray Sensor Plugin matching Paper limited vision range R = 1.6m -->
  <gazebo reference="laser_frame">
    <sensor type="ray" name="rplidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>8.00</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>scan_raw</topicName>
        <frameName>laser_frame</frameName>
      </plugin>
    </sensor>
  </gazebo>

</robot>
