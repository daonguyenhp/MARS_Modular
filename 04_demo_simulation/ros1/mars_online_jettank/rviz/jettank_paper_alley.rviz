Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /LaserScan1
        - /RobotModel1
        - /MarkerArray1
      Splitter Ratio: 0.5
    Tree Height: 650
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 5
        Y: 5
        Z: 0
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: odom
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: JetTank Robot
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/LaserScan
      Color: 0; 255; 200
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Relative Partner: 0
      Min Color: 0; 0; 0
      Name: JetTank LiDAR
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.055
      Style: Flat Squares
      Topic: /scan_raw
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.65
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: LiDAR Occupancy Map
      Topic: /mars_online/map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /mars_online/markers
      Name: MARS Bundles & Targets
      Namespaces:
        active_waypoint: true
        center_labels: true
        closed_sights: true
        entry_path_marker: true
        observation_centers: true
        open_points: true
        open_sights: true
        perceived_walls: true
        ray_bundles: true
        return_path_marker: true
        target: true
        vision_boundary: true
      Queue Size: 100
      Value: true
    - Alpha: 0.4
      Buffer Length: 1
      Class: rviz/Path
      Color: 180; 180; 180
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.02
      Name: Driven Trail (All)
      Offset:
        X: 0
        Y: 0
        Z: 0.02
      Pose Color: 180; 180; 180
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic: /mars_online/trail
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 65; 20
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Alley Entry Path (Đường đi vào)
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Style: None
      Topic: /mars_online/entry
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 220; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.09
      Name: DAP Return Path (Đường đi ra)
      Offset:
        X: 0
        Y: 0
        Z: 0.07
      Pose Style: None
      Topic: /mars_online/return
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 50; 255; 70
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Active Step Plan (Bước đi kế tiếp)
      Offset:
        X: 0
        Y: 0
        Z: 0.09
      Pose Style: None
      Topic: /mars_online/plan
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 38; 45
    Default Light: true
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 13.5
      Focal Point:
        X: 5.0
        Y: 5.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.85
    Saved: ~
