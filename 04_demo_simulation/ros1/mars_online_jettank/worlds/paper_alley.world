<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="paper_alley">
    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Arena Boundary & Obstacle Walls from Paper Benchmark (Fig. 8 & Fig. 9) -->
    <model name="paper_wall_00">
      <static>true</static>
      <pose>5.000 0.200 0.30 0 0 0</pose>
      <link name="wall">
        <collision name="solid"><geometry><box><size>10.000 0.400 0.60</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.000 0.400 0.60</size></box></geometry>
          <material><ambient>0.48 0.53 0.58 1</ambient><diffuse>0.48 0.53 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="paper_wall_01">
      <static>true</static>
      <pose>0.200 5.000 0.30 0 0 0</pose>
