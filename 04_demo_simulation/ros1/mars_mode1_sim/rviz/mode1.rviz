Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.15
      Class: rviz/Grid
      Cell Size: 1
      Name: Grid
      Plane: XY
      Reference Frame: map
      Value: false
    - Alpha: 0.35
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Name: Occupancy map
      Topic: /map
      Value: false
    - Class: rviz/MarkerArray
      Marker Topic: /dsfm_online/polygon_markers
      Name: Mode 1 markers
      Queue Size: 100
      Value: true
    - Class: rviz/Path
      Color: 38; 191; 38
      Line Style: Lines
      Name: Planned path
      Topic: /planned_path
      Value: false
    - Class: rviz/Pose
      Color: 32; 74; 135
      Head Length: 0.06
      Head Radius: 0.028
      Name: Robot pose
      Shaft Length: 0.12
      Shaft Radius: 0.015
      Shape: Arrow
      Topic: /robot_current_pose
      Value: true
  Enabled: true
  Global Options:
    Background Color: 244; 241; 234
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top view
      Near Clip Distance: 0.01
      Scale: 110
      Target Frame: map
      X: 1.0
      Y: 1.9
Window Geometry:
  Height: 900
  Width: 1400
